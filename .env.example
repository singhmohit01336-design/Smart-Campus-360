# ==========================================
# SmartCampus 360 - Environment Configuration
# ==========================================
# Copy this file to .env and replace placeholders with your actual settings.
# Never commit your real .env file to version control.

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql+psycopg://postgres:your_password_here@localhost:5432/smartcampus360

# JWT Authentication
# Generate a secure key in terminal: openssl rand -hex 32
SECRET_KEY=replace_with_a_secure_random_secret_key_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Configuration (Comma-separated origins for Vite frontend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application Environment (development, testing, production)
ENVIRONMENT=development

# File Uploads Directory
UPLOAD_DIR=uploads
