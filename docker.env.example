# ========================================================
# SmartCampus 360 - Docker Local Environment Configuration
# ========================================================
# Copy this file to .env.docker for custom docker-compose overrides.

# Database Configuration (Docker internal network)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=smartcampus360_docker
DATABASE_URL=postgresql+psycopg://postgres:postgres_dev_password@db:5432/smartcampus360_docker

# Application Secret Key (replace with secure key in production)
SECRET_KEY=docker_dev_secret_key_change_in_production_32chars

# CORS Configuration (allows browser access to backend API)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8000
